# Required. Use a fresh random value of at least 32 characters. Never commit .env.
MLAG_AUTH_TOKEN=replace-with-a-fresh-random-token

# offline = deterministic local demo; real = authenticated Gemini calls.
MLAG_MODE=offline
MLAG_PROVIDER=gemini
MLAG_MODEL=gemini-3.8-flash
MLAG_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Required only when MLAG_MODE=real. Keep it only in the ignored .env.
MLAG_GEMINI_API_KEY=

# Remote ordinary conversation requires this config value AND the in-app consent checkbox.
MLAG_ALLOW_REMOTE_PERSONAL_DATA=false

MLAG_HOST=127.0.0.1
MLAG_PORT=8787
MLAG_TRUSTED_HOSTS=127.0.0.1,localhost
# Keep false unless a separately reviewed deployment explicitly needs a
# non-loopback bind. Docker overrides this only inside the container.
MLAG_ALLOW_NON_LOOPBACK_BINDING=false
MLAG_DATA_DIR=./data
MLAG_ALLOWED_ROOT=./workspace

# Gemini 3.8 Flash planning rates; refresh from the official pricing page before billing decisions.
MLAG_MONTHLY_BUDGET_INR=3500
MLAG_FX_INR_PER_USD=95
MLAG_INPUT_PRICE_USD_PER_MILLION=0.75
MLAG_OUTPUT_PRICE_USD_PER_MILLION=3.75
MLAG_MAX_INPUT_TOKENS=12000
MLAG_MAX_OUTPUT_TOKENS=2048
MLAG_MAX_MESSAGE_CHARS=12000
MLAG_MAX_CONTEXT_MESSAGES=20
MLAG_MAX_MEMORY_CHARS=2000
MLAG_MAX_FILE_BYTES=1048576
MLAG_MAX_FETCH_BYTES=1048576
MLAG_FETCH_TIMEOUT_SECONDS=10
