# Required: use a long random value. Never commit the real value.
JARVIS_AUTH_TOKEN=replace-with-a-random-32-byte-token

# Safe defaults: loopback only and deterministic offline provider.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_TRUSTED_HOSTS=127.0.0.1,localhost
JARVIS_PROVIDER=fake
JARVIS_MODEL=jarvis-local-safe
JARVIS_DATA_DIR=./data
JARVIS_ALLOWED_ROOT=./workspace

# Remote OpenAI-compatible provider is opt-in. If enabled, personal/file data
# remains blocked unless this flag is explicitly true.
JARVIS_PROVIDER_URL=
JARVIS_PROVIDER_API_KEY=
JARVIS_ALLOW_REMOTE_PERSONAL_DATA=false

# Budget is enforced before every paid/remote call. Fake calls cost zero.
JARVIS_MONTHLY_BUDGET_INR=3500
JARVIS_FX_INR_PER_USD=95
JARVIS_INPUT_PRICE_USD_PER_MILLION=0.75
JARVIS_OUTPUT_PRICE_USD_PER_MILLION=3.75
JARVIS_MAX_INPUT_TOKENS=12000
JARVIS_MAX_OUTPUT_TOKENS=2048
JARVIS_MAX_MESSAGE_CHARS=12000
JARVIS_MAX_FILE_BYTES=1048576
JARVIS_MAX_FETCH_BYTES=1048576
JARVIS_FETCH_TIMEOUT_SECONDS=10
